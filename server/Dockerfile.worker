# Celery 워커 이미지 (bpm / separation 두 워커가 공유)
# API와 달리 librosa, torch, demucs, ffmpeg 가 모두 필요하다.
# 파이썬 버전은 EC2 운영 환경(3.14)과 맞춘다. 3.13 부터 표준 라이브러리에서
# 빠진 audioop/aifc 등의 백포트 패키지가 requirements 에 포함돼 있다.
FROM python:3.14-slim

WORKDIR /app

# track_separate.py 가 subprocess 로 ffmpeg 을 호출한다.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# torch 는 CPU 전용 휠로 먼저 설치한다.
# 기본 PyPI 휠은 CUDA 라이브러리를 포함해 2GB 이상 더 커진다.
RUN pip install --no-cache-dir \
      torch==2.12.0 torchaudio==2.11.0 \
      --index-url https://download.pytorch.org/whl/cpu

# 나머지 의존성 (torch 는 위에서 이미 설치돼 건너뛴다)
# requirements.txt 가 torch==2.12.0+cpu 처럼 +cpu 버전을 고정하므로
# PyTorch 인덱스를 보조로 함께 조회해야 한다.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
      --extra-index-url https://download.pytorch.org/whl/cpu

COPY . .

# 실행 명령은 compose 에서 워커별로 지정한다 (-Q bpm / -Q separation)
